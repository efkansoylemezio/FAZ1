# Secret taraması — gitleaks kurulu olmalı: brew install gitleaks
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --verbose || {
    echo "❌ gitleaks secret tespit etti — commit engellendi."
    exit 1
  }
else
  echo "⚠️  gitleaks kurulu değil: brew install gitleaks"
fi

npm run typecheck && npm run lint
